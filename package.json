{
  "name": "pink-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "setup": "node scripts/setup.ts",
    "start": "node --env-file=.env scripts/start.ts",
    "start:app": "node --env-file=.env server/index.ts",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts && python3 -B -m unittest discover -s tests -p \"*_test.py\"",
    "test:e2e": "node scripts/test-audio.ts && playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm test && npm run build && npm run format:check",
    "measure": "node scripts/measure.ts",
    "measure:private": "node scripts/measure.ts --private",
    "setup:private": "node scripts/setup-private.ts",
    "start:private": "node --env-file=.env.private scripts/start.ts",
    "serve:private": "node --env-file=.env.private scripts/serve-private.ts",
    "diagnose": "node --env-file=.env scripts/diagnose.ts",
    "diagnose:private": "node --env-file=.env.private scripts/diagnose.ts",
    "test:private": "node scripts/test-audio.ts && playwright test --config=playwright.private.config.ts",
    "test:tailnet": "node scripts/test-audio.ts && playwright test --config=playwright.tailnet.config.ts"
  },
  "dependencies": {
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.2"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
