# Local development only. Run npm run setup to generate real values in .env.
JOIN_CODE=replace-with-a-long-random-code
LIVEKIT_API_KEY=replace-with-random-key
LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters

# Private mode is generated separately by npm run setup:private in .env.private.
# See docs/remote-access.md; never put JOIN_CODE in private configuration.
